# --- Clerk (autenticación) ---
# Dashboard de Clerk → tu proyecto → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Rutas de Clerk (opcional, ya están fijadas también en el código)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Supabase (base de datos: metadatos + contenido de los GPX) ---
# Dashboard de Supabase → tu proyecto → Project Settings → API
# OJO: SUPABASE_SERVICE_ROLE_KEY es secreta. NUNCA debe llevar el prefijo
# NEXT_PUBLIC_ ni usarse en código de cliente — solo se lee en las API
# routes (servidor).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
